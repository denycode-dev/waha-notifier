{
  "name": "coolify-waha-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight Coolify to WAHA notification bridge",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/server.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
